[
    "Готово! Компонент Fragment установлен.",
    "===============================================================",
    "Fragment — это обёртка без создания дополнительного DOM-узла.",
    "Используется для группировки элементов или возврата нескольких",
    "корневых элементов из компонента.",
    "===============================================================",
    "Доступные атрибуты:",
    "   children (передается вторым аргументом как строка HTML)",
    "===============================================================",
    "Примеры использования:",
    "   <?php render_component('ui.Fragment', [], '<p>Пункт 1</p><p>Пункт 2</p>'); ?>",
    "===============================================================",
    "   <?php",
    "   $content = component('ui.Button', ['label' => 'Кнопка 1']) . component('ui.Button', ['label' => 'Кнопка 2']);",
    "   render_component('ui.Fragment', [], $content);",
    "   ?>",
    "===============================================================",
    "Или с помощью шортката:",
    "   <?php fragment([], '<span>Один</span><span>Два</span>'); ?>"
]